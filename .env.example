# Vorlage für die lokale Konfiguration. Kopie als .env anlegen und Werte eintragen.
# Die Datei .env ist per .gitignore ausgeschlossen und darf nie eingecheckt werden.

# Supabase MCP-Server (Nur-Lese-Modus, auf ein Projekt beschränkt)
# Projekt-Referenz: Supabase Dashboard, Project Settings, General
SUPABASE_PROJECT_REF=
# Personal Access Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Next.js App (wird ab M2 benötigt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
