# Kopieren nach .env und Werte eintragen. Die Datei .env wird nie eingecheckt.

# Next.js (web/): oeffentlicher Zugriff mit Anon-Key, nur lesend ueber RLS
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Python-Pipeline (pipeline/): direkte Postgres-Verbindung, nur lokal
DATABASE_URL=postgresql://postgres.<projekt-ref>:<passwort>@<host>:6543/postgres

# Oeffentliche URL der Seite, fuer kanonische Adressen, Sitemap und Open Graph.
# Auf Vercel optional: ohne diesen Wert wird die Produktionsadresse des Projekts
# verwendet. Nur bei einer eigenen Domain hier setzen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
